<Window x:Class="TarekGamingSpace.Views.StripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:TarekGamingSpace.Core"
        xmlns:v="clr-namespace:TarekGamingSpace.Views"
        Title="Tarek Gaming Space"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True"
        FontFamily="{DynamicResource BodyFont}"
        Topmost="{Binding AlwaysOnTop}" Opacity="{Binding StripOpacity}"
        FlowDirection="{Binding Flow, Source={x:Static core:Loc.I}}">
    <Border CornerRadius="10" Background="{StaticResource StripBrush}" BorderBrush="{StaticResource SoftLineBrush}"
            BorderThickness="1">
        <StackPanel>
            <!-- name bar: drag here to move the whole strip -->
            <Border x:Name="BrandBar" CornerRadius="10,10,0,0" Padding="10,6" BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="BrandBar_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#40107C10" Offset="0"/>
                        <GradientStop Color="#00107C10" Offset="0.65"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Cursor" Value="SizeAll"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Locked}" Value="True">
                                <Setter Property="Cursor" Value="Arrow"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="False">
                    <ContentPresenter ContentTemplate="{StaticResource Logo}" Width="20" Height="20" DockPanel.Dock="Left"/>
                    <TextBlock Text="TAREK" DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource TextBrush}" FlowDirection="LeftToRight">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#52B043" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding [BrandSub], Source={x:Static core:Loc.I}}" DockPanel.Dock="Left" Margin="8,1,0,0"
                               VerticalAlignment="Center" FontFamily="{DynamicResource DisplayFont}" FontWeight="SemiBold"
                               FontSize="10.5" Foreground="{StaticResource XboxBrush}"/>
                    <!-- grip dots -->
                    <Grid DockPanel.Dock="Right" Width="22" Height="8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Locked}" Value="True">
                                        <Setter Property="Opacity" Value="0.2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.Background>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,5,4" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Brush="#8B9A90">
                                        <GeometryDrawing.Geometry>
                                            <EllipseGeometry Center="2.5,2" RadiusX="1" RadiusY="1"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Grid.Background>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Right-to-left panel: Poste 1 sits on the right and new postes attach on the left. -->
            <ItemsControl ItemsSource="{Binding Postes}" FlowDirection="RightToLeft" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <v:PosteView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
