<Window x:Class="TarekGamingSpace.Views.StripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:TarekGamingSpace.Core"
        xmlns:v="clr-namespace:TarekGamingSpace.Views"
        Title="Tarek Gaming Space"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True"
        FontFamily="{DynamicResource BodyFont}"
        Topmost="{Binding AlwaysOnTop}" Opacity="{Binding WindowOpacity}"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        FlowDirection="{Binding Flow, Source={x:Static core:Loc.I}}">
    <!-- Only the dark panel fades in "Background" mode, so the text keeps full opacity. -->
    <Border CornerRadius="10" BorderBrush="{StaticResource SoftLineBrush}" BorderThickness="1">
        <Border.Background>
            <SolidColorBrush Color="{StaticResource GroundColor}" Opacity="{Binding BackgroundOpacity}"/>
        </Border.Background>
        <StackPanel x:Name="Body">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TextShadow}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.85"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <!-- name bar: drag here to move the whole strip -->
            <Border x:Name="BrandBar" CornerRadius="10,10,0,0" Padding="10,6" BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="BrandBar_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#40107C10" Offset="0"/>
                        <GradientStop Color="#00107C10" Offset="0.65"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Cursor" Value="SizeAll"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Locked}" Value="True">
                                <Setter Property="Cursor" Value="Arrow"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="False">
                    <ContentPresenter ContentTemplate="{StaticResource Logo}" Width="20" Height="20" DockPanel.Dock="Left"/>
                    <TextBlock Text="TAREK" DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource TextBrush}" FlowDirection="LeftToRight">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#52B043" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding [BrandSub], Source={x:Static core:Loc.I}}" DockPanel.Dock="Left" Margin="8,1,0,0"
                               VerticalAlignment="Center" FontFamily="{DynamicResource DisplayFont}" FontWeight="SemiBold"
                               FontSize="10.5" Foreground="{StaticResource XboxBrush}"/>
                    <!-- grip dots -->
                    <Grid DockPanel.Dock="Right" Width="22" Height="8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Locked}" Value="True">
                                        <Setter Property="Opacity" Value="0.2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.Background>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,5,4" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Brush="#8B9A90">
                                        <GeometryDrawing.Geometry>
                                            <EllipseGeometry Center="2.5,2" RadiusX="1" RadiusY="1"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Grid.Background>
                    </Grid>
                    <!-- quick opacity control (a button, so pressing it does not start a drag) -->
                    <ToggleButton x:Name="OpacityButton" DockPanel.Dock="Right" Margin="16,0,0,0" Padding="6,0" Height="22"
                                  Style="{StaticResource ChromeBtn}" PreviewMouseWheel="OpacityButton_MouseWheel"
                                  IsChecked="{Binding IsOpen, ElementName=OpacityPopup}"
                                  ToolTip="{Binding [Opacity], Source={x:Static core:Loc.I}}"
                                  AutomationProperties.Name="{Binding [Opacity], Source={x:Static core:Loc.I}}">
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <Path Data="{StaticResource HalfCircleIcon}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                            <TextBlock Text="{Binding OpacityText}" Margin="5,0,0,0" FontFamily="{DynamicResource DigitsFont}"
                                       FontWeight="Normal" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="OpacityPopup" PlacementTarget="{Binding ElementName=OpacityButton}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6"
                           Opened="OpacityPopup_Opened" Closed="OpacityPopup_Closed">
                        <Border Width="250" Padding="12" CornerRadius="10" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                FlowDirection="{Binding Flow, Source={x:Static core:Loc.I}}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding OpacityText}" DockPanel.Dock="Right" FlowDirection="LeftToRight"
                                               FontFamily="{DynamicResource DigitsFont}" FontSize="20" Foreground="{StaticResource XboxBrush}"/>
                                    <TextBlock Text="{Binding [Opacity], Source={x:Static core:Loc.I}}" Style="{StaticResource H3}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Slider x:Name="OpacitySlider" Margin="0,8,0,8" Minimum="{Binding MinOpacity}" Maximum="1"
                                        SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True" Value="{Binding StripOpacity}" Foreground="{StaticResource XboxBrush}"
                                        AutomationProperties.Name="{Binding [Opacity], Source={x:Static core:Loc.I}}"/>
                                <UniformGrid Columns="4" FlowDirection="LeftToRight">
                                    <Button Style="{StaticResource Btn}" Margin="0,0,4,0" Padding="0,5" Content="25%" Command="{Binding SetOpacityCommand}" CommandParameter="25"/>
                                    <Button Style="{StaticResource Btn}" Margin="0,0,4,0" Padding="0,5" Content="50%" Command="{Binding SetOpacityCommand}" CommandParameter="50"/>
                                    <Button Style="{StaticResource Btn}" Margin="0,0,4,0" Padding="0,5" Content="75%" Command="{Binding SetOpacityCommand}" CommandParameter="75"/>
                                    <Button Style="{StaticResource Btn}" Padding="0,5" Content="100%" Command="{Binding SetOpacityCommand}" CommandParameter="100"/>
                                </UniformGrid>
                                <TextBlock Text="{Binding [OpacityHint], Source={x:Static core:Loc.I}}" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                                <TextBlock Margin="0,6,0,0" FontSize="12">
                                    <Hyperlink Foreground="{StaticResource XboxBrush}" Click="MoreOptions_Click">
                                        <Run Text="{Binding [MoreOptions], Source={x:Static core:Loc.I}, Mode=OneWay}"/>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Popup>
                </DockPanel>
            </Border>

            <!-- Right-to-left panel: Poste 1 sits on the right and new postes attach on the left. -->
            <ItemsControl ItemsSource="{Binding Postes}" FlowDirection="RightToLeft" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <v:PosteView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
