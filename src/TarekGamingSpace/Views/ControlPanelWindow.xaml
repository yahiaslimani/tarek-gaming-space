<Window x:Class="TarekGamingSpace.Views.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:TarekGamingSpace.Core"
        Title="{Binding [AppName], Source={x:Static core:Loc.I}}"
        Width="760" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="{DynamicResource BodyFont}" Foreground="{StaticResource TextBrush}"
        FlowDirection="{Binding Flow, Source={x:Static core:Loc.I}}">
    <Window.Resources>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="LastChildFill" Value="False"/>
        </Style>
        <Style x:Key="DimmableRow" TargetType="DockPanel" BasedOn="{StaticResource Row}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
        <DockPanel>
            <!-- title bar -->
            <Border DockPanel.Dock="Top" Padding="14,8,6,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                    Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <ContentPresenter ContentTemplate="{StaticResource Logo}" Width="22" Height="22" DockPanel.Dock="Left"/>
                    <TextBlock Text="TAREK" Margin="10,0,0,0" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold"
                               FontSize="15" VerticalAlignment="Center" FlowDirection="LeftToRight" DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding [BrandSub], Source={x:Static core:Loc.I}}" Margin="8,1,0,0" FontSize="11"
                               FontFamily="{DynamicResource DisplayFont}" FontWeight="SemiBold" Foreground="{StaticResource XboxBrush}"
                               VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding [ControlPanel], Source={x:Static core:Loc.I}}" Margin="12,0,0,0"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ChromeBtn}" Content="—" Click="Minimize_Click"
                                ToolTip="{Binding [Minimize], Source={x:Static core:Loc.I}}" AutomationProperties.Name="{Binding [Minimize], Source={x:Static core:Loc.I}}"/>
                        <Button Style="{StaticResource ChromeBtn}" Content="✕" Click="Close_Click"
                                ToolTip="{Binding [Close], Source={x:Static core:Loc.I}}" AutomationProperties.Name="{Binding [Close], Source={x:Static core:Loc.I}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- postes -->
                <StackPanel Margin="18,16,18,18">
                    <TextBlock Text="{Binding [Postes], Source={x:Static core:Loc.I}}" Style="{StaticResource H3}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Postes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <Ellipse Width="8" Height="8" DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource XboxBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsIdleShown}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource MutedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                            Content="{Binding [Delete], Source={x:Static core:Loc.I}}"
                                            Command="{Binding DeleteCommand}"/>
                                    <TextBox Style="{StaticResource Input}" MaxLength="24"
                                             Text="{Binding NameEdit, UpdateSourceTrigger=LostFocus}"
                                             KeyDown="NameBox_KeyDown"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,4,0,0"
                            Content="{Binding [AddPoste], Source={x:Static core:Loc.I}}" Command="{Binding AddPosteCommand}"/>
                    <TextBlock Text="{Binding [MaxNote], Source={x:Static core:Loc.I}}" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource LineBrush}"/>

                <!-- settings -->
                <StackPanel Grid.Column="2" Margin="18,16,18,18">
                    <TextBlock Text="{Binding [Settings], Source={x:Static core:Loc.I}}" Style="{StaticResource H3}" Margin="0,0,0,12"/>

                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="{Binding [Rate], Source={x:Static core:Loc.I}}" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBox Style="{StaticResource NumberInput}" MaxLength="6" PreviewTextInput="Digits_PreviewTextInput"
                                     Text="{Binding HourlyRateText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding [DZD], Source={x:Static core:Loc.I}}" Style="{StaticResource Label}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="{Binding [Language], Source={x:Static core:Loc.I}}" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <RadioButton Style="{StaticResource Choice}" GroupName="lang" Content="English" Margin="0,0,4,0"
                                         IsChecked="{Binding Language, Converter={StaticResource Equals}, ConverterParameter=en}"/>
                            <RadioButton Style="{StaticResource Choice}" GroupName="lang" Content="العربية" FontFamily="Segoe UI"
                                         IsChecked="{Binding Language, Converter={StaticResource Equals}, ConverterParameter=ar}"/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="{Binding [Startup], Source={x:Static core:Loc.I}}" Style="{StaticResource Label}"/>
                        <CheckBox Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding RunAtStartup}"/>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="{Binding [Warning], Source={x:Static core:Loc.I}}" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding [WarningHint], Source={x:Static core:Loc.I}}" Style="{StaticResource Muted}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <TextBox Style="{StaticResource NumberInput}" Width="56" MaxLength="3" PreviewTextInput="Digits_PreviewTextInput"
                                     Text="{Binding WarningMinutesText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding [Min], Source={x:Static core:Loc.I}}" Style="{StaticResource Label}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="{Binding [SoundOn], Source={x:Static core:Loc.I}}" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding [SoundOnHint], Source={x:Static core:Loc.I}}" Style="{StaticResource Muted}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding SoundEnabled}"
                                  AutomationProperties.Name="{Binding [SoundOn], Source={x:Static core:Loc.I}}"/>
                    </DockPanel>

                    <DockPanel Style="{StaticResource DimmableRow}" IsEnabled="{Binding SoundEnabled}">
                        <TextBlock Text="{Binding [Sound], Source={x:Static core:Loc.I}}" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <RadioButton Style="{StaticResource Choice}" GroupName="snd" Margin="0,0,4,0" Padding="9,6"
                                         Content="{Binding [Chime], Source={x:Static core:Loc.I}}"
                                         IsChecked="{Binding Sound, Converter={StaticResource Equals}, ConverterParameter=Chime}"/>
                            <RadioButton Style="{StaticResource Choice}" GroupName="snd" Margin="0,0,4,0" Padding="9,6"
                                         Content="{Binding [Alarm], Source={x:Static core:Loc.I}}"
                                         IsChecked="{Binding Sound, Converter={StaticResource Equals}, ConverterParameter=Alarm}"/>
                            <RadioButton Style="{StaticResource Choice}" GroupName="snd" Margin="0,0,8,0" Padding="9,6"
                                         Content="{Binding [Arcade], Source={x:Static core:Loc.I}}"
                                         IsChecked="{Binding Sound, Converter={StaticResource Equals}, ConverterParameter=Arcade}"/>
                            <Button Style="{StaticResource Btn}" Padding="9,6" Command="{Binding TestSoundCommand}"
                                    ToolTip="{Binding [Test], Source={x:Static core:Loc.I}}" AutomationProperties.Name="{Binding [Test], Source={x:Static core:Loc.I}}">
                                <Path Data="{StaticResource PlayIcon}" Fill="{StaticResource TextBrush}" Width="11" Height="11"
                                      Stretch="Uniform" FlowDirection="LeftToRight"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="{Binding [Opacity], Source={x:Static core:Loc.I}}" Style="{StaticResource Label}"/>
                        <Slider DockPanel.Dock="Right" Width="130" Minimum="0.4" Maximum="1" VerticalAlignment="Center"
                                SmallChange="0.05" LargeChange="0.1" IsMoveToPointEnabled="True"
                                Value="{Binding StripOpacity}" Foreground="{StaticResource XboxBrush}"/>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="{Binding [OnTop], Source={x:Static core:Loc.I}}" Style="{StaticResource Label}"/>
                        <CheckBox Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding AlwaysOnTop}"/>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="{Binding [Lock], Source={x:Static core:Loc.I}}" Style="{StaticResource Label}"/>
                        <CheckBox Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Locked}"/>
                    </DockPanel>

                    <Button Style="{StaticResource BtnPrimary}" Margin="0,4,0,0" Padding="12,8"
                            Content="{Binding ToggleStripText}" Command="{Binding ToggleStripCommand}"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
