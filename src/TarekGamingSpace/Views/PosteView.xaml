<UserControl x:Class="TarekGamingSpace.Views.PosteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:TarekGamingSpace.Core"
             Width="190" Background="Transparent"
             FlowDirection="{Binding Flow, Source={x:Static core:Loc.I}}">
    <UserControl.ContextMenu>
        <ContextMenu FlowDirection="{Binding Flow, Source={x:Static core:Loc.I}}">
            <MenuItem Header="{Binding [Start], Source={x:Static core:Loc.I}}" Command="{Binding StartCommand}"
                      Visibility="{Binding CanStart, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="{Binding [Pause], Source={x:Static core:Loc.I}}" Command="{Binding PauseCommand}"
                      Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="{Binding [Resume], Source={x:Static core:Loc.I}}" Command="{Binding ResumeCommand}"
                      Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="{Binding [AddTimeMenu], Source={x:Static core:Loc.I}}" Command="{Binding AddTimeCommand}"
                      Visibility="{Binding CanAddTime, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="{Binding [MakeOpen], Source={x:Static core:Loc.I}}" Command="{Binding MakeOpenCommand}"
                      Visibility="{Binding CanMakeOpen, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="{Binding [SetTimer], Source={x:Static core:Loc.I}}" Command="{Binding SetTimerCommand}"
                      Visibility="{Binding CanSetTimer, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="{Binding [Stop], Source={x:Static core:Loc.I}}" Command="{Binding StopCommand}"
                      Visibility="{Binding CanStop, Converter={StaticResource BoolToVis}}"/>
            <Separator/>
            <MenuItem Header="{Binding [OpenControlPanel], Source={x:Static core:Loc.I}}" Command="{Binding Main.ShowPanelCommand}"/>
            <MenuItem Header="{Binding [HideAll], Source={x:Static core:Loc.I}}" Command="{Binding Main.ToggleStripCommand}"/>
        </ContextMenu>
    </UserControl.ContextMenu>

    <Grid x:Name="Root" MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <!-- keeps an orange or red block solid when the strip background is faded -->
        <Border Background="{StaticResource GroundBrush}"
                Visibility="{Binding SolidBackground, Converter={StaticResource BoolToVis}}"/>
        <Border x:Name="Card" BorderBrush="#10FFFFFF" BorderThickness="1,0,0,0" Padding="12,11,12,10">
            <StackPanel>
                <!-- name + mode chip -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NameText" Text="{Binding DisplayName}" FontFamily="{DynamicResource DisplayFont}"
                               FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Border x:Name="Chip" Grid.Column="1" CornerRadius="9" BorderThickness="1" Padding="7,0,7,1"
                            Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ChipLabel" Text="{Binding ChipText}" FontFamily="{DynamicResource DisplayFont}"
                                   FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                </Grid>

                <!-- big clock: digits always left-to-right -->
                <TextBlock x:Name="TimeLabel" Text="{Binding TimeText}" FontFamily="{DynamicResource DigitsFont}"
                           FontSize="40" HorizontalAlignment="Center" Margin="0,2,0,2" FlowDirection="LeftToRight"/>

                <!-- progress (timer only) -->
                <Grid Height="4" Margin="0,0,0,5">
                    <Border CornerRadius="2" Background="#14FFFFFF"
                            Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>
                    <Border x:Name="ProgressFill" CornerRadius="2" HorizontalAlignment="Left" FlowDirection="LeftToRight"
                            Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- price + status -->
                <DockPanel>
                    <!-- Follows the language direction: "180 DZD" in English, "180 دج" read right-to-left in Arabic. -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                x:Name="MoneyPanel" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding MoneyText}" FontFamily="{DynamicResource DigitsFont}" FontSize="19"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding [DZD], Source={x:Static core:Loc.I}}" Margin="4,0,0,2" FontSize="11"
                                   VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SubText}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6,0,0,1"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- coloured state stripe on top -->
        <Rectangle x:Name="Stripe" Height="3" VerticalAlignment="Top"/>

        <!-- hover controls -->
        <Border x:Name="Controls" VerticalAlignment="Bottom" Padding="6,14,6,7">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#000B0F0D" Offset="0"/>
                    <GradientStop Color="#F00B0F0D" Offset="0.35"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource IconBtnGo}" Command="{Binding StartCommand}"
                        Visibility="{Binding CanStart, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding [Start], Source={x:Static core:Loc.I}}" AutomationProperties.Name="{Binding [Start], Source={x:Static core:Loc.I}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource PlayIcon}" Fill="{StaticResource TextBrush}" Width="13" Height="13"
                              Stretch="Uniform" FlowDirection="LeftToRight"/>
                        <TextBlock Text="{Binding [Start], Source={x:Static core:Loc.I}}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconBtn}" Command="{Binding ResumeCommand}"
                        Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding [Resume], Source={x:Static core:Loc.I}}" AutomationProperties.Name="{Binding [Resume], Source={x:Static core:Loc.I}}">
                    <Path Data="{StaticResource PlayIcon}" Fill="{StaticResource TextBrush}" Width="12" Height="12"
                          Stretch="Uniform" FlowDirection="LeftToRight"/>
                </Button>
                <Button Style="{StaticResource IconBtn}" Command="{Binding PauseCommand}"
                        Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding [Pause], Source={x:Static core:Loc.I}}" AutomationProperties.Name="{Binding [Pause], Source={x:Static core:Loc.I}}">
                    <Path Data="{StaticResource PauseIcon}" Fill="{StaticResource TextBrush}" Width="12" Height="12" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource IconBtn}" Command="{Binding AddTimeCommand}"
                        Content="{Binding [AddShort], Source={x:Static core:Loc.I}}"
                        Visibility="{Binding CanAddTime, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding [AddTime], Source={x:Static core:Loc.I}}" AutomationProperties.Name="{Binding [AddTime], Source={x:Static core:Loc.I}}"/>
                <Button Style="{StaticResource IconBtn}" Command="{Binding MakeOpenCommand}" Content="∞" FontSize="15"
                        Visibility="{Binding CanMakeOpen, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding [MakeOpen], Source={x:Static core:Loc.I}}" AutomationProperties.Name="{Binding [MakeOpen], Source={x:Static core:Loc.I}}"/>
                <Button Style="{StaticResource IconBtn}" Command="{Binding SetTimerCommand}"
                        Content="{Binding [Timer], Source={x:Static core:Loc.I}}"
                        Visibility="{Binding CanSetTimer, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding [SetTimer], Source={x:Static core:Loc.I}}" AutomationProperties.Name="{Binding [SetTimer], Source={x:Static core:Loc.I}}"/>
                <Button Style="{StaticResource IconBtnStop}" Command="{Binding StopCommand}"
                        Visibility="{Binding CanStop, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding [Stop], Source={x:Static core:Loc.I}}" AutomationProperties.Name="{Binding [Stop], Source={x:Static core:Loc.I}}">
                    <Path Data="{StaticResource StopIcon}" Fill="{StaticResource TextBrush}" Width="11" Height="11" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
