<Window x:Class="TarekGamingSpace.Views.StartDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:TarekGamingSpace.Core"
        Title="Tarek Gaming Space" Width="410" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="{DynamicResource BodyFont}" Foreground="{StaticResource TextBrush}"
        FlowDirection="{Binding Flow, Source={x:Static core:Loc.I}}">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            CornerRadius="12" Padding="18" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="PlayedText" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" Visibility="Collapsed"/>

            <UniformGrid Columns="2" Margin="0,14,0,0">
                <ToggleButton x:Name="ChoiceA" Style="{StaticResource ModeCard}" Margin="0,0,4,0" Checked="ChoiceA_Checked" Unchecked="KeepSelection">
                    <StackPanel>
                        <TextBlock x:Name="ChoiceATitle" FontFamily="{DynamicResource DisplayFont}" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock x:Name="ChoiceADesc" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ChoiceB" Style="{StaticResource ModeCard}" Margin="4,0,0,0" Checked="ChoiceB_Checked" Unchecked="KeepSelection">
                    <StackPanel>
                        <TextBlock x:Name="ChoiceBTitle" FontFamily="{DynamicResource DisplayFont}" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock x:Name="ChoiceBDesc" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </ToggleButton>
            </UniformGrid>

            <StackPanel x:Name="TimerPanel" Margin="0,14,0,0">
                <UniformGrid x:Name="Presets" Columns="3"/>
                <DockPanel Margin="0,10,0,0">
                    <TextBlock x:Name="CustomLabel" Style="{StaticResource Label}" FontSize="13" DockPanel.Dock="Left"/>
                    <TextBox x:Name="CustomBox" Style="{StaticResource NumberInput}" Margin="10,0,8,0" DockPanel.Dock="Left"
                             MaxLength="3" TextChanged="CustomBox_TextChanged" PreviewTextInput="CustomBox_PreviewTextInput"/>
                    <TextBlock x:Name="MinLabel" Style="{StaticResource Label}" FontSize="13" DockPanel.Dock="Left"/>
                </DockPanel>
                <TextBlock x:Name="EstimateText" Style="{StaticResource Muted}" FontSize="13" Margin="0,10,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelBtn" Style="{StaticResource Btn}" IsCancel="True" Margin="0,0,8,0" Click="CancelBtn_Click"/>
                <Button x:Name="GoBtn" Style="{StaticResource BtnPrimary}" IsDefault="True" Click="GoBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
