<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.5 is built into Windows 8/8.1/10/11, so nothing extra is needed on old PCs. -->
    <TargetFramework>net45</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TarekGamingSpace</RootNamespace>
    <AssemblyName>TarekGamingSpace</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- AnyCPU without Prefer32Bit: runs as 64-bit on x64 Windows and 32-bit on x86 Windows. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.0.5</Version>
    <Product>Tarek Gaming Space</Product>
    <Company>Tarek Gaming Space</Company>
    <Copyright>© 2026 Tarek Gaming Space</Copyright>
    <AssemblyTitle>Tarek Gaming Space</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TarekGamingSpace.Tests" />
  </ItemGroup>

</Project>
