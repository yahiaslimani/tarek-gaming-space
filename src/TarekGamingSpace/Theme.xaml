<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:TarekGamingSpace.Core">

    <!-- Palette (same as the approved mockup) -->
    <Color x:Key="GroundColor">#0B0F0D</Color>
    <Color x:Key="XboxColor">#52B043</Color>
    <SolidColorBrush x:Key="GroundBrush" Color="#0B0F0D"/>
    <SolidColorBrush x:Key="StripBrush" Color="#0B0F0D"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#131916"/>
    <SolidColorBrush x:Key="RaiseBrush" Color="#1B231F"/>
    <SolidColorBrush x:Key="LineBrush" Color="#2A3530"/>
    <SolidColorBrush x:Key="SoftLineBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E6EFE8"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8B9A90"/>
    <SolidColorBrush x:Key="DimBrush" Color="#3A4640"/>
    <SolidColorBrush x:Key="XboxBrush" Color="#52B043"/>
    <SolidColorBrush x:Key="XboxDeepBrush" Color="#107C10"/>
    <SolidColorBrush x:Key="XboxTintBrush" Color="#33107C10"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#F2A93B"/>
    <SolidColorBrush x:Key="AlertBrush" Color="#FF4D4D"/>
    <SolidColorBrush x:Key="PausedBrush" Color="#C9B458"/>

    <core:EqualsConverter x:Key="Equals"/>
    <core:BoolToVisibilityConverter x:Key="BoolToVis"/>

    <!-- Fonts are registered in App.OnStartup (embedded files with a Segoe UI fallback for Arabic). -->

    <Style x:Key="H3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Buttons: the hover colour lives in Style.Triggers so derived styles can override it. -->
    <Style x:Key="Btn" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="{StaticResource RaiseBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource XboxBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource XboxBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource XboxDeepBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource XboxBrush}"/>
    </Style>

    <Style x:Key="IconBtn" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Padding" Value="7,0"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="2,0"/>
    </Style>

    <Style x:Key="IconBtnGo" TargetType="ButtonBase" BasedOn="{StaticResource IconBtn}">
        <Setter Property="Background" Value="{StaticResource XboxDeepBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource XboxBrush}"/>
        <Setter Property="Padding" Value="14,0"/>
    </Style>

    <Style x:Key="IconBtnStop" TargetType="ButtonBase" BasedOn="{StaticResource IconBtn}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AlertBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChromeBtn" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>

    <!-- Toggle / radio buttons used for presets, language and sound choices. -->
    <Style x:Key="Choice" TargetType="ToggleButton" BasedOn="{StaticResource Btn}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource XboxDeepBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource XboxBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ModeCard" TargetType="ToggleButton" BasedOn="{StaticResource Btn}">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource XboxTintBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource XboxBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- On/off switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="{StaticResource LineBrush}"
                            BorderThickness="1" BorderBrush="Transparent">
                        <Ellipse x:Name="Knob" Width="16" Height="16" Margin="2,0" HorizontalAlignment="Left"
                                 Fill="{StaticResource TextBrush}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource XboxDeepBrush}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource XboxBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource GroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource XboxBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource XboxBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NumberInput" TargetType="TextBox" BasedOn="{StaticResource Input}">
        <Setter Property="FontFamily" Value="{DynamicResource DigitsFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Width" Value="80"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    </Style>

    <!-- Logo: green ring with a "T" -->
    <DataTemplate x:Key="Logo">
        <Viewbox>
            <Canvas Width="24" Height="24">
                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Fill="#22107C10"
                         Stroke="{StaticResource XboxBrush}" StrokeThickness="1.8"/>
                <Path Data="M7.5,8 L16.5,8 M12,8 L12,17" Stroke="{StaticResource TextBrush}"
                      StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <Geometry x:Key="PlayIcon">M4,2.5 L4,13.5 L13,8 Z</Geometry>
    <Geometry x:Key="PauseIcon">M4,2.5 L7,2.5 L7,13.5 L4,13.5 Z M9,2.5 L12,2.5 L12,13.5 L9,13.5 Z</Geometry>
    <!-- ring with the right half filled (even-odd: outer, inner hole, half disc) -->
    <Geometry x:Key="HalfCircleIcon">F0 M8,1.5 A6.5,6.5 0 1 1 8,14.5 A6.5,6.5 0 1 1 8,1.5 Z M8,2.9 A5.1,5.1 0 1 1 8,13.1 A5.1,5.1 0 1 1 8,2.9 Z M8,2.9 A5.1,5.1 0 0 1 8,13.1 Z</Geometry>
    <Geometry x:Key="StopIcon">M3.5,3.5 L12.5,3.5 L12.5,12.5 L3.5,12.5 Z</Geometry>
</ResourceDictionary>
